# Application
APP_NAME=AI Business Analytics
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Database (defaults to local SQLite for zero-setup dev; use Postgres in prod)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Example Postgres: postgresql+asyncpg://user:pass@localhost:5432/analytics

# Auth (mock single-user as per requirements)
AUTH_EMAIL=balaji@aibusinessanalytics.com
AUTH_PASSWORD=Password1!
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# Scraper: html | mock
SCRAPER_ADAPTER=mock
SCRAPER_PROXY_URL=
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_SECONDS=20
AMAZON_BASE_URL=https://www.amazon.in/dp/

# AI / LLM: mock | openai | anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Scheduler (cron hours for 3x/day scraping)
SCRAPE_HOURS=6,14,22

# CORS
CORS_ORIGINS=http://localhost:5173
